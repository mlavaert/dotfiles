  if [[ ! -x "${tofu_bin}" || ! -f "${verified_marker}" ]]; then
    command -v unzip >/dev/null || { log_error "opentofu: 'unzip' is required"; return 1; }
    mkdir -p "${direnv_bin_dir}"

