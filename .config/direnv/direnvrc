    local base_url="https://github.com/opentofu/opentofu/releases/download/v${tofu_version}"
    local tmp_zip
    tmp_zip="$(mktemp "${PWD}/.direnv/${pkg_name}.XXXX")" || return 1

    log_status "=> Downloading opentofu ${tofu_version} (${tofu_arch})"
    if ! curl -fsSL "${base_url}/${pkg_name}" -o "${tmp_zip}"; then
      rm -f "${tmp_zip}"
      log_error "opentofu: download failed for ${pkg_name} (bad version/arch?)"
