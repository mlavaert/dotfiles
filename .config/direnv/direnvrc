layout_uv() {
  if [[ -d ".venv" ]]; then
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
    log_status "No virtual environment exists. Executing \`uv venv\` to create one."

    if [[ -z $1 ]]; then
      uv venv
    else
      uv venv --python "$1" --native-tls
    fi
    VIRTUAL_ENV="$(pwd)/.venv"
  fi

  PATH_add "$VIRTUAL_ENV/bin"
  export UV_ACTIVE=1 # or VENV_ACTIVE=1
  export VIRTUAL_ENV

  # Keep dependencies in sync if this is a uv project
  if [[ -f "uv.lock" ]]; then
    watch_file uv.lock
    watch_file pyproject.toml
    uv sync
  fi
}

use_sops() {
  local file="${1:-.env.sops}"

  if ! command -v sops &>/dev/null; then
    log_error "sops not found. Install from https://github.com/getsops/sops"
    return 1
  fi

  # Watch even when missing, so direnv reloads as soon as the file appears
  watch_file "$file"

  if [[ ! -f "$file" ]]; then
    log_error "SOPS file not found: $file"
    return 1
  fi

  if ! command -v jq &>/dev/null; then
    log_error "jq not found; required by use_sops"
    return 1
  fi

  # Decrypt as JSON (dotenv output mangles multi-line values like PEM keys:
  # the lines after the first would be executed as shell commands).
  local decrypted
  if ! decrypted="$(sops --decrypt --output-type json "$file")"; then
    log_error "sops: failed to decrypt $file"
    return 1
  fi

  # Export each top-level scalar key/value. Values are passed via NUL-
  # separated records with a \x1f separator, so multi-line values survive.
  local entry key value
  while IFS= read -r -d '' entry; do
    key="${entry%%$'\x1f'*}"
    value="${entry#*$'\x1f'}"
    export "$key=$value"
  done < <(jq -j 'to_entries[]
    | select(.value | type == "string" or type == "number" or type == "boolean")
    | "\(.key)\u001f\(.value)\u0000"' <<< "$decrypted")
}

# Detect HashiCorp-style arch string (e.g. darwin_arm64, linux_amd64)
_terraform_arch() {
  local os arch
  case "$(uname -s)" in
    Darwin) os="darwin" ;;
    Linux) os="linux" ;;
    *) log_error "terraform: unsupported OS: $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) arch="amd64" ;;
    arm64|aarch64) arch="arm64" ;;
    *) log_error "terraform: unsupported architecture: $(uname -m)"; return 1 ;;
  esac
  echo "${os}_${arch}"
}

# Resolve latest terraform version, cached for 24h to avoid network calls on
# every direnv reload. Falls back to a pinned version when offline.
_TERRAFORM_FALLBACK_VERSION="1.9.5"
_terraform_latest_version() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv"
  local cache_file="${cache_dir}/terraform-latest-version"
  local max_age=$((24 * 3600))

  if [[ -f "${cache_file}" ]]; then
    local age=$(( $(date +%s) - $(date -r "${cache_file}" +%s) ))
    if (( age < max_age )); then
      cat "${cache_file}"
      return 0
    fi
  fi

  local version
  version="$(curl -fsSL --connect-timeout 2 --max-time 4 https://checkpoint-api.hashicorp.com/v1/check/terraform \
    | sed -n 's/.*"current_version":"\([^"]*\)".*/\1/p')"

  if [[ -n "${version}" ]]; then
    mkdir -p "${cache_dir}"
    printf '%s' "${version}" > "${cache_file}"
    echo "${version}"
  elif [[ -f "${cache_file}" ]]; then
    log_status "terraform: offline, using cached latest version"
    cat "${cache_file}"
  else
    log_status "terraform: offline, falling back to ${_TERRAFORM_FALLBACK_VERSION}"
    echo "${_TERRAFORM_FALLBACK_VERSION}"
  fi
}

layout_terraform() {
  # Priority: explicit arg > .terraform-version file > latest release
  local tf_version="${1:-}"
  if [[ -z "${tf_version}" && -f ".terraform-version" ]]; then
    tf_version="$(< ".terraform-version")"
    tf_version="${tf_version//[$'\t\r\n ']/}"  # trim whitespace
    watch_file ".terraform-version"
  fi
  [[ -n "${tf_version}" ]] || tf_version="$(_terraform_latest_version)"
  local tf_arch="${TF_ARCH:-$(_terraform_arch)}" || return 1

  # Per-version bin dir so switching versions/archs doesn't leave stale binaries
  local direnv_bin_dir="${PWD}/.direnv/terraform-${tf_version}-${tf_arch}"
  local tf_bin="${direnv_bin_dir}/terraform"
  # Marker proving tf_bin was verified for this version; avoids launching
  # terraform (slow Go startup, ~200-400ms) on every direnv reload.
  local verified_marker="${direnv_bin_dir}/.verified-${tf_version}"

  if [[ ! -f "${verified_marker}" && -x "${tf_bin}" ]]; then
    # Binary already present (e.g. installed before markers existed);
    # verify it once instead of re-downloading.
    if "${tf_bin}" --version | grep -q "Terraform v${tf_version}"; then
      touch "${verified_marker}"
    else
      log_status "terraform: existing binary mismatch, reinstalling"
    fi
  fi

  if [[ ! -x "${tf_bin}" || ! -f "${verified_marker}" ]]; then
    command -v unzip >/dev/null || { log_error "terraform: 'unzip' is required"; return 1; }
    mkdir -p "${direnv_bin_dir}"

    local pkg_name="terraform_${tf_version}_${tf_arch}.zip"
    local base_url="https://releases.hashicorp.com/terraform/${tf_version}"
    local tmp_zip
    tmp_zip="$(mktemp "${PWD}/.direnv/${pkg_name}.XXXX")" || return 1

    log_status "=> Downloading terraform ${tf_version} (${tf_arch})"
    if ! curl -fsSL "${base_url}/${pkg_name}" -o "${tmp_zip}"; then
      rm -f "${tmp_zip}"
      log_error "terraform: download failed for ${pkg_name} (bad version/arch?)"
      return 1
    fi

    # Verify checksum against official SHA256SUMS if shasum is available
    if command -v shasum >/dev/null; then
      local expected actual sums
      sums="$(curl -fsSL "${base_url}/terraform_${tf_version}_SHA256SUMS" 2>/dev/null)"
      expected="$(grep " ${pkg_name}\$" <<< "${sums}" | awk '{print $1}')"
      actual="$(shasum -a 256 "${tmp_zip}" | awk '{print $1}')"
      if [[ -n "${expected}" && "${expected}" != "${actual}" ]]; then
        rm -f "${tmp_zip}"
        log_error "terraform: SHA256 checksum mismatch for ${pkg_name}!"
        return 1
      fi
    else
      log_status "=> Skipping checksum verification (shasum not found)"
    fi

    unzip -oq "${tmp_zip}" -d "${direnv_bin_dir}" || { rm -f "${tmp_zip}"; log_error "terraform: unzip failed"; return 1; }
    rm -f "${tmp_zip}"
    chmod +x "${tf_bin}"

    # Verify the binary once, then remember it via the marker file
    if ! "${tf_bin}" --version | grep -q "Terraform v${tf_version}"; then
      log_error "terraform: installed binary does not report v${tf_version}"
      return 1
    fi
    touch "${verified_marker}"
  fi

  PATH_add "${direnv_bin_dir}"
  export TF_VERSION="${tf_version}"
}

# Resolve latest opentofu version, cached for 24h to avoid network calls on
# every direnv reload. Falls back to a pinned version when offline.
_OPENTOFU_FALLBACK_VERSION="1.11.5"
_opentofu_latest_version() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv"
  local cache_file="${cache_dir}/opentofu-latest-version"
  local max_age=$((24 * 3600))

  if [[ -f "${cache_file}" ]]; then
    local age=$(( $(date +%s) - $(date -r "${cache_file}" +%s) ))
    if (( age < max_age )); then
      cat "${cache_file}"
      return 0
    fi
  fi

  local version tag
  tag="$(curl -fsSL --connect-timeout 2 --max-time 4 https://api.github.com/repos/opentofu/opentofu/releases/latest \
    | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')"
  version="${tag#v}"

  if [[ -n "${version}" ]]; then
    mkdir -p "${cache_dir}"
    printf '%s' "${version}" > "${cache_file}"
    echo "${version}"
  elif [[ -f "${cache_file}" ]]; then
    log_status "opentofu: offline, using cached latest version"
    cat "${cache_file}"
  else
    log_status "opentofu: offline, falling back to ${_OPENTOFU_FALLBACK_VERSION}"
    echo "${_OPENTOFU_FALLBACK_VERSION}"
  fi
}

layout_opentofu() {
  # Priority: explicit arg > .opentofu-version file > latest release
  local tofu_version="${1:-}"
