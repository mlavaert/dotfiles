      local expected actual sums
      sums="$(curl -fsSL "${base_url}/tofu_${tofu_version}_SHA256SUMS" 2>/dev/null)"
      expected="$(grep " ${pkg_name}\$" <<< "${sums}" | awk '{print $1}')"
      actual="$(shasum -a 256 "${tmp_zip}" | awk '{print $1}')"
      if [[ -n "${expected}" && "${expected}" != "${actual}" ]]; then
        rm -f "${tmp_zip}"
        log_error "opentofu: SHA256 checksum mismatch for ${pkg_name}!"
        return 1
      fi
    else
      log_status "=> Skipping checksum verification (shasum not found)"
    fi

    unzip -oq "${tmp_zip}" -d "${direnv_bin_dir}" || { rm -f "${tmp_zip}"; log_error "opentofu: unzip failed"; return 1; }
    rm -f "${tmp_zip}"
